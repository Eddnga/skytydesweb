# ---- SkyTydes Safaris ----
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

# Block private files
<FilesMatch "^(config\.php|config\.sample\.php|.*\.sqlite|.*\.log|.*\.lock|\.ht.*|\.env|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
# Hide every dotfile/dotfolder (.my.cnf, .gitignore, .cpanel.yml, .git) except .well-known (SSL checks)
RedirectMatch 403 (^|/)\.(?!well-known/)
RedirectMatch 403 ^/?(includes|storage)(/|$)
RedirectMatch 403 /install/(schema|seed)\.php$

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---- Rewrite rules ----
# Chajio runs OpenLiteSpeed, which only reads the rewrite rules in .htaccess.
# So every protection that matters is repeated here as a rewrite rule.
# (After uploading a changed .htaccess, press "Restart container" in MyPanel.)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Private files and folders → 403 Forbidden
  RewriteCond %{REQUEST_URI} !/\.well-known/
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(includes|storage)(/|$) - [F,L]
  RewriteRule ^install/(schema|seed)\.php$ - [F,L]
  RewriteRule ^uploads/docs/ - [F,L]
  RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|html?|js|svg)$ - [F,L,NC]
  RewriteRule ^(config|config\.sample|router)\.php$ - [F,L]
  RewriteRule \.(sqlite|log|lock|md|ya?ml|sql|zip|bak|env)$ - [F,L,NC]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^llms\.txt$ llms.php [L]
  RewriteRule ^llms-full\.txt$ llms.php?full=1 [L]

  # Clean addresses: /tours, /tours/big-five, /destinations/maasai-mara, /blog/my-post
  RewriteRule ^tours/([a-z0-9-]+)/?$ tour.php?slug=$1 [L,QSA]
  RewriteRule ^destinations/([a-z0-9-]+)/?$ destination.php?slug=$1 [L,QSA]
  RewriteRule ^blog/([a-z0-9-]+)/?$ post.php?slug=$1 [L,QSA]
  RewriteRule ^sections/([a-z0-9_]+)/([a-z0-9-]+)/?$ section.php?type=$1&slug=$2 [L,QSA]
  RewriteRule ^sections/([a-z0-9_]+)/?$ section.php?type=$1 [L,QSA]
  RewriteRule ^(tours|destinations|offers|gallery|blog|reviews|about|contact|services|faqs|documents)/?$ $1.php [L,QSA]

  # Anything else that doesn't exist → the SkyTydes 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>
