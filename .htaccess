# ---- SkyTydes Safaris ----
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

# Block private files
<FilesMatch "^(config\.php|config\.sample\.php|.*\.sqlite|.*\.log|.*\.lock|\.ht.*|\.env|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
# Hide every dotfile/dotfolder (.my.cnf, .gitignore, .cpanel.yml, .git) except .well-known (SSL checks)
RedirectMatch 403 (^|/)\.(?!well-known/)
RedirectMatch 403 ^/?(includes|storage)(/|$)
RedirectMatch 403 /install/(schema|seed)\.php$

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
